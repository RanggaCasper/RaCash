# URL Go API yang dipanggil BFF (Nitro). Di produksi pakai jaringan internal.
NUXT_API_BASE=http://localhost:8080

# Cookie sesi Secure. Set false hanya untuk development lewat http://.
NUXT_COOKIE_SECURE=false

# Origin tambahan yang boleh mengirim request non-GET ke /api/** (dipisah koma).
# Origin situs sendiri selalu diizinkan.
NUXT_ALLOWED_ORIGINS=

NUXT_PUBLIC_SITE_NAME=RaCash
