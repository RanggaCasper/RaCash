APP_ENV=local
LOG_LEVEL=info

HTTP_ADDR=:8080
METRICS_ADDR=:9090

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=racash
DB_PASSWORD=racash
DB_NAME=racash
DB_SSLMODE=disable
# Buat DB_NAME otomatis bila belum ada (butuh hak CREATEDB). Kosong = hanya di APP_ENV=local.
# DB_AUTO_CREATE=true
# DB_MAINTENANCE_NAME=postgres
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

REDIS_URL=redis://localhost:6379/0

# Kunci AES-256. Buat dengan: make keygen   (atau go run ./cmd/keygen)
# Rotasi: make keygen-rotate ID=k2  → kunci lama tetap dicantumkan, kunci baru jadi aktif.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=k1

WORKER_CONCURRENCY=10
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# Integration test (opsional) — pakai database TERPISAH dari development
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_USER=racash
# TEST_DB_PASSWORD=racash
# TEST_DB_NAME=racash_test
# TEST_DB_SSLMODE=disable
