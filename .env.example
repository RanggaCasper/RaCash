# Dipakai docker-compose (lokal). Salin ke .env: cp .env.example .env
# Lingkungan lain: lihat deploy/env/staging.env.example dan production.env.example.
APP_ENV=local
LOG_LEVEL=info

WEB_DOMAIN=localhost
API_DOMAIN=api.localhost
NUXT_COOKIE_SECURE=false
NUXT_ALLOWED_ORIGINS=

# Port di host (container saling terhubung lewat port standar). Ubah bila bentrok.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

DB_USER=racash
DB_PASSWORD=racash
DB_NAME=racash

# Rahasia HMAC access token, minimal 32 karakter. Buat: openssl rand -base64 48
JWT_SECRET=

# Buat dengan: (cd topup-backend && make keygen)
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=k1

# MinIO (S3-compatible)
S3_ACCESS_KEY=racash
S3_SECRET_KEY=racash-secret

# Lokal memakai adapter fake; tidak ada kunci vendor.
